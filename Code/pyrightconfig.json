{
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "**/node_modules",
        "**/.*",
        "**/__pycache__",
        "**/.git",
        "**/.hg",
        "**/.svn",
        ".venv",
        "venv"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.11",
    "pythonPlatform": "Windows",
    "typeCheckingMode": "basic",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "executionEnvironments": [
        {
            "root": ".",
            "extraPaths": [
                "src"
            ]
        }
    ]
}